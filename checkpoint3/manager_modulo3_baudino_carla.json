      "parameters": {
        "inputText": "=Estado previo del caso: {{ $('Normalizar Contexto').first().json.estado_previo }}\nMensaje del usuario: {{ $('Chat Trigger').first().json.chatInput }}",
        "categories": {
          "categories": [
            {
              "category": "LEAD_COMERCIAL",
              "description": "Consultas de potenciales clientes interesados en contratar servicios de transporte o logística (cotizaciones, volúmenes, rutas, disponibilidad de flota), incluyendo mensajes que solo aportan datos de contacto (nombre, empresa, email) o detalles de su necesidad comercial."
            },
            {
              "category": "RECLAMO_OPERATIVO",
              "description": "Reclamos o consultas de clientes existentes sobre envíos en curso o realizados: demoras, mercadería dañada o faltante, seguimiento de un envío, problemas con una entrega o con el servicio prestado."
            }
          ]
        },
        "options": {
          "fallback": "other",
          "systemPromptTemplate": "Sos el router de triaje de una empresa logística. Clasificá el mensaje del usuario en UNA sola de las categorías permitidas. Si el mensaje no encaja claramente en ninguna (saludos sueltos, facturación, temas ajenos a la empresa, pedidos ambiguos), clasificalo como 'other'. No respondas al usuario, solo clasificá. Tené en cuenta el estado previo del caso: si es 'Lead en calificación' y el mensaje continúa esa conversación (aporta nombre, empresa, email, volúmenes, fechas o pregunta por la cotización), clasificalo como LEAD_COMERCIAL. Si es 'Reclamo derivado a Operaciones' y el mensaje sigue hablando del mismo envío, clasificalo como RECLAMO_OPERATIVO."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.textClassifier",
      "typeVersion": 1.1,
