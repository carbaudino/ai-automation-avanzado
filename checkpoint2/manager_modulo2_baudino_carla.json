{
  "name": "M2 - Manager - Orquestador de Consultas",
  "nodes": [
    {
      "parameters": { "options": {} },
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [0, 0],
      "id": "c3d4e5f6-3333-4c33-8c33-000000000001",
      "name": "Chat Trigger",
      "webhookId": "m2-manager-orquestador-trigger"
    },
    {
      "parameters": {
        "inputText": "={{ $json.chatInput }}",
        "categories": {
          "categories": [
            {
              "category": "LEAD_COMERCIAL",
              "description": "Consultas de potenciales clientes interesados en contratar servicios de transporte o logística (cotizaciones, volúmenes, rutas, disponibilidad de flota), incluyendo mensajes que solo aportan datos de contacto (nombre, empresa, email) o detalles de su necesidad comercial."
            },
            {
              "category": "RECLAMO_OPERATIVO",
              "description": "Reclamos o consultas de clientes existentes sobre envíos en curso o realizados: demoras, mercadería dañada o faltante, seguimiento de un envío, problemas con una entrega o con el servicio prestado."
            }
          ]
        },
        "options": {
          "fallback": "other",
          "systemPromptTemplate": "Sos el router de triaje de una empresa logística. Clasificá el mensaje del usuario en UNA sola de las categorías permitidas. Si el mensaje no encaja claramente en ninguna (saludos sueltos, facturación, temas ajenos a la empresa, pedidos ambiguos), clasificalo como 'other'. No respondas al usuario, solo clasificá."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.textClassifier",
      "typeVersion": 1.1,
      "position": [240, 0],
      "id": "c3d4e5f6-3333-4c33-8c33-000000000002",
      "name": "Router de Intención"
    },
    {
      "parameters": {
        "model": "openai/gpt-oss-120b",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [240, 240],
      "id": "c3d4e5f6-3333-4c33-8c33-000000000003",
      "name": "Groq Chat Model",
      "credentials": {
        "groqApi": { "id": "MHA9d0DnIvqS1WG2", "name": "Groq account" }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "m-cl-1", "name": "request_id", "value": "={{ $execution.id }}", "type": "string" },
            { "id": "m-cl-2", "name": "session_id", "value": "={{ $('Chat Trigger').first().json.sessionId }}", "type": "string" },
            { "id": "m-cl-3", "name": "mensaje", "value": "={{ $('Chat Trigger').first().json.chatInput }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [560, -240],
      "id": "c3d4e5f6-3333-4c33-8c33-000000000004",
      "name": "Contrato - Worker Leads"
    },
    {
      "parameters": {
        "workflowId": { "__rl": true, "value": "REEMPLAZAR_ID_WORKER_1", "mode": "id" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "request_id": "={{ $json.request_id }}",
            "session_id": "={{ $json.session_id }}",
            "mensaje": "={{ $json.mensaje }}"
          },
          "matchingColumns": [],
          "schema": [
            { "id": "request_id", "displayName": "request_id", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string", "removed": false },
            { "id": "session_id", "displayName": "session_id", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string", "removed": false },
            { "id": "mensaje", "displayName": "mensaje", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string", "removed": false }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": { "waitForSubWorkflow": true }
      },
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [800, -240],
      "id": "c3d4e5f6-3333-4c33-8c33-000000000005",
      "name": "Delegar - Worker 1 Leads",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "m-ll-1", "name": "request_id", "value": "={{ $('Contrato - Worker Leads').first().json.request_id }}", "type": "string" },
            { "id": "m-ll-2", "name": "intencion", "value": "LEAD_COMERCIAL", "type": "string" },
            { "id": "m-ll-3", "name": "worker_invocado", "value": "Worker 1 - Calificación de Leads", "type": "string" },
            { "id": "m-ll-4", "name": "parametros_enviados", "value": "={{ JSON.stringify($('Contrato - Worker Leads').first().json) }}", "type": "string" },
            { "id": "m-ll-5", "name": "status", "value": "={{ $json.status ?? 'error' }}", "type": "string" },
            { "id": "m-ll-6", "name": "respuesta_worker", "value": "={{ JSON.stringify($json) }}", "type": "string" },
            { "id": "m-ll-7", "name": "respuesta_usuario", "value": "={{ $json.status === 'success' ? $json.data.respuesta : 'Recibimos su mensaje, pero no pudimos procesarlo automáticamente. Un ejecutivo comercial se va a contactar a la brevedad.' }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1060, -240],
      "id": "c3d4e5f6-3333-4c33-8c33-000000000006",
      "name": "Armar Log - Leads"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "m-cr-1", "name": "request_id", "value": "={{ $execution.id }}", "type": "string" },
            { "id": "m-cr-2", "name": "mensaje", "value": "={{ $('Chat Trigger').first().json.chatInput }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [560, 0],
      "id": "c3d4e5f6-3333-4c33-8c33-000000000007",
      "name": "Contrato - Worker Reclamos"
    },
    {
      "parameters": {
        "workflowId": { "__rl": true, "value": "REEMPLAZAR_ID_WORKER_2", "mode": "id" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "request_id": "={{ $json.request_id }}",
            "mensaje": "={{ $json.mensaje }}"
          },
          "matchingColumns": [],
          "schema": [
            { "id": "request_id", "displayName": "request_id", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string", "removed": false },
            { "id": "mensaje", "displayName": "mensaje", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string", "removed": false }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": { "waitForSubWorkflow": true }
      },
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [800, 0],
      "id": "c3d4e5f6-3333-4c33-8c33-000000000008",
      "name": "Delegar - Worker 2 Reclamos",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "m-lr-1", "name": "request_id", "value": "={{ $('Contrato - Worker Reclamos').first().json.request_id }}", "type": "string" },
            { "id": "m-lr-2", "name": "intencion", "value": "RECLAMO_OPERATIVO", "type": "string" },
            { "id": "m-lr-3", "name": "worker_invocado", "value": "Worker 2 - Redacción de Derivación de Reclamos", "type": "string" },
            { "id": "m-lr-4", "name": "parametros_enviados", "value": "={{ JSON.stringify($('Contrato - Worker Reclamos').first().json) }}", "type": "string" },
            { "id": "m-lr-5", "name": "status", "value": "={{ $json.status ?? 'error' }}", "type": "string" },
            { "id": "m-lr-6", "name": "respuesta_worker", "value": "={{ JSON.stringify($json) }}", "type": "string" },
            { "id": "m-lr-7", "name": "respuesta_usuario", "value": "={{ $json.status === 'success' ? $json.data.respuesta_cliente : 'Recibimos su reclamo, pero no pudimos procesarlo automáticamente. Un responsable de Operaciones lo va a revisar a la brevedad.' }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1060, 0],
      "id": "c3d4e5f6-3333-4c33-8c33-000000000009",
      "name": "Armar Log - Reclamos"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "m-le-1", "name": "request_id", "value": "={{ $execution.id }}", "type": "string" },
            { "id": "m-le-2", "name": "intencion", "value": "OTHER (fuera de taxonomía)", "type": "string" },
            { "id": "m-le-3", "name": "worker_invocado", "value": "Ninguno - Escalamiento a supervisor humano", "type": "string" },
            { "id": "m-le-4", "name": "parametros_enviados", "value": "={{ JSON.stringify({ mensaje: $('Chat Trigger').first().json.chatInput }) }}", "type": "string" },
            { "id": "m-le-5", "name": "status", "value": "escalado", "type": "string" },
            { "id": "m-le-6", "name": "respuesta_worker", "value": "N/A", "type": "string" },
            { "id": "m-le-7", "name": "respuesta_usuario", "value": "Gracias por su mensaje. Su consulta fue derivada a un responsable, que se va a contactar a la brevedad.", "type": "string" }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1060, 240],
      "id": "c3d4e5f6-3333-4c33-8c33-000000000010",
      "name": "Armar Log - Escalamiento"
    },
    {
      "parameters": {
        "fromEmail": "car.baudino@gmail.com",
        "toEmail": "car.baudino@gmail.com",
        "subject": "={{ $json.status === 'success' ? '[OK]' : '[REQUIERE REVISIÓN HUMANA]' }} Log Orquestador - {{ $json.intencion }} - {{ $now.format('yyyy-MM-dd HH:mm') }}",
        "emailFormat": "text",
        "text": "=LOG DE TRAZABILIDAD - ORQUESTADOR MULTI-AGENTE\n\nRequest ID: {{ $json.request_id }}\nIntención clasificada: {{ $json.intencion }}\nWorker invocado: {{ $json.worker_invocado }}\nStatus: {{ $json.status }}\n\nParámetros enviados al Worker:\n{{ $json.parametros_enviados }}\n\nRespuesta devuelta por el Worker:\n{{ $json.respuesta_worker }}\n\nRespuesta final al usuario:\n{{ $json.respuesta_usuario }}\n\nCorreo generado automáticamente para auditoría del proceso. Los estados distintos de 'success' requieren revisión de un supervisor humano.",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1320, 0],
      "id": "c3d4e5f6-3333-4c33-8c33-000000000011",
      "name": "Log Trazabilidad (Gmail SMTP)",
      "webhookId": "m2-log-trazabilidad-smtp",
      "credentials": {
        "smtp": { "id": "OWzYkC7rlUbeu8EO", "name": "SMTP account" }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "m-out-1",
              "name": "output",
              "value": "={{ $('Armar Log - Leads').isExecuted ? $('Armar Log - Leads').first().json.respuesta_usuario : ($('Armar Log - Reclamos').isExecuted ? $('Armar Log - Reclamos').first().json.respuesta_usuario : $('Armar Log - Escalamiento').first().json.respuesta_usuario) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1560, 0],
      "id": "c3d4e5f6-3333-4c33-8c33-000000000012",
      "name": "Respuesta al Chat"
    }
  ],
